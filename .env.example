# ==============================================================================
# MikroTik Universal Rust Gateway - Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env jika ingin kustomisasi environment:
# cp .env.example .env

# Port gateway di mesin host (default: 8080)
GATEWAY_PORT=8080

# Master Admin Bearer Token (Opsional)
# Kosongkan untuk Public Service Mode (terbuka untuk testing publik & ephemeral session ticket).
# Isi minimal 32 karakter jika ingin membatasi gateway dengan token privat master.
GATEWAY_TOKEN=

# Token Read-Only untuk Web Map Embed (Opsional, minimal 16 karakter)
# GATEWAY_VIEWER_TOKEN=your-random-viewer-token-here

# Level Log Tracing (info, debug, warn, error)
RUST_LOG=info

# Izinkan target router dinamis via header X-Router-Host (default: 1 / true)
GATEWAY_ALLOW_DYNAMIC_ROUTERS=1

# Izinkan CORS dari domain tertentu (pisahkan koma) atau * untuk semua domain
# GATEWAY_CORS_ORIGINS=*
