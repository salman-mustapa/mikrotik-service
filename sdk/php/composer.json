{
  "name": "salman-mustapa/mikrotik-service",
  "description": "High-performance MikroTik RouterOS Client powered by Rust Core Gateway",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Salman Mustapa",
      "email": "salmanmustapa@outlook.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Mikrotik\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mikrotik\\Laravel\\MikrotikServiceProvider"
      ],
      "aliases": {
        "Mikrotik": "Mikrotik\\Laravel\\Facades\\Mikrotik"
      }
    }
  }
}
