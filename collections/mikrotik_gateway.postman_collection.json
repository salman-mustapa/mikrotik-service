{
  "info": {
    "_postman_id": "a9182c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
    "name": "MikroTik Universal Rust Gateway API",
    "description": "Universal REST API & SSE collection for interacting with MikroTik RouterOS across any tech stack (React, Vue, Laravel, Node, Python, Flutter, etc.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "change-me-to-a-long-random-string",
      "type": "string"
    },
    {
      "key": "router_host",
      "value": "ath.vpnbersama.us",
      "type": "string"
    },
    {
      "key": "router_port",
      "value": "51121",
      "type": "string"
    },
    {
      "key": "router_user",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "router_pass",
      "value": "password_anda",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "System - Resources (CPU & RAM)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Router-Host", "value": "{{router_host}}" },
          { "key": "X-Router-Port", "value": "{{router_port}}" },
          { "key": "X-Router-User", "value": "{{router_user}}" },
          { "key": "X-Router-Pass", "value": "{{router_pass}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{base_url}}/api/v1/system/resource", "host": ["{{base_url}}"], "path": ["api", "v1", "system", "resource"] }
      }
    },
    {
      "name": "System - Identity",
