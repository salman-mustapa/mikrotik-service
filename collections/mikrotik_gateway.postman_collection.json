        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address\": \"103.1.2.3\",\n  \"list\": \"BLACKLIST_ATTACK\",\n  \"timeout\": \"7d\",\n  \"comment\": \"Blocked via Gateway\"\n}"
