    {
      "name": "Universal Raw Command",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"router\": {\n    \"host\": \"{{router_host}}\",\n    \"port\": {{router_port}},\n    \"user\": \"{{router_user}}\",\n    \"password\": \"{{router_pass}}\"\n  },\n  \"command\": \"/system/resource/print\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/v1/command", "host": ["{{base_url}}"], "path": ["api", "v1", "command"] }
      }
    },
    {
      "name": "Realtime Traffic Stream (SSE)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "text/event-stream" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/interfaces/stream?host={{router_host}}&port={{router_port}}&user={{router_user}}&password={{router_pass}}&interface=ether1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "interfaces", "stream"],
          "query": [
            { "key": "host", "value": "{{router_host}}" },
            { "key": "port", "value": "{{router_port}}" },
            { "key": "user", "value": "{{router_user}}" },
            { "key": "password", "value": "{{router_pass}}" },
            { "key": "interface", "value": "ether1" }
          ]
        }
      }
