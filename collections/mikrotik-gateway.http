X-Router-Host: {{routerHost}}
X-Router-Port: {{routerPort}}
X-Router-User: {{routerUser}}
X-Router-Pass: {{routerPass}}
Content-Type: application/json

{
  "mac_address": "AA:BB:CC:DD:EE:FF",
  "binding_type": "bypassed",
  "comment": "Smart TV Ruang Tamu"
}

